# FRZE Strapi 5 Backend (used server-side and via /api/frze/* proxy)
FRZE_API_URL=https://api.frzeapp.in
FRZE_APP_KEY=vibe_os

# Optional: Read-only Strapi API Token if you want /blog to pull live CMS posts from /api/blogs
# Keep this server-side only (never prefix with NEXT_PUBLIC_).
STRAPI_API_TOKEN=

# Public links
NEXT_PUBLIC_SITE_URL=https://frzeapp.in
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.frze.app
